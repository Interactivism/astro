---
/**
 * Base layout for every page on the site.
 * Provides: <head> with SEO/OG/favicon, skip link, Header, main slot, mobile Footer.
 *
 * Props:
 *   title       — page title (prepended to "— Interactivism")
 *   description — meta description + OG description (falls back to site default)
 *   ogImage     — OG image path from public/ root (falls back to /og-default.png)
 *   ogType      — 'website' (default) or 'article' (blog posts, case studies)
 *   canonical   — explicit canonical URL (falls back to current page URL)
 */
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { LogoVariant } from '../lib/imageBrightness';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  fullBleed?: boolean;
  /**
   * Set true when the page begins with a <Marquee> component.
   * Suppresses the mobile logo spacer so the marquee starts flush at the top
   * (the mobile logo overlaps the marquee's top-left corner instead).
   */
  hasMarquee?: boolean;
  /** Extra classes applied to <body>. Use "overflow-hidden" on full-bleed pages. */
  bodyClass?: string;
  /**
   * Which logo variant renders in the desktop sidenav knockout.
   * Computed at build time from the page's background image brightness.
   * Defaults to 'light' (white wordmark). Slider overrides at runtime.
   */
  logoVariant?: LogoVariant;
}

const {
  title,
  description = 'Digital product design & development studio. Pasadena, CA.',
  ogImage = '/og-default.png',
  ogType = 'website',
  canonical,
  fullBleed = false,
  hasMarquee = false,
  bodyClass = '',
  logoVariant: logoVariantProp,
} = Astro.props;

// Pages without a marquee use the tile logo in the sidenav.
// Pages with a marquee derive the variant from image brightness analysis.
const logoVariant: LogoVariant = logoVariantProp ?? (hasMarquee ? 'light' : 'tile');

const siteUrl = 'https://interactivism.com';
const pageUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const pageTitle = `${title} — Interactivism`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Interactivism" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicon kit (source of truth: DESIGN.md "Favicon and web manifest") -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F2DB07" />

    <!--
      Google Analytics — add GA4 measurement ID to enable.
      Replace G-XXXXXXXXXX with the real ID before launch.

      <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-XXXXXXXXXX');
      </script>
    -->
  </head>

  <body class={bodyClass || undefined}>
    <!-- Skip to main content — first focusable element, visually hidden until focused -->
    <a
      href="#main-content"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-[100] focus-visible:bg-accent focus-visible:text-headline focus-visible:font-medium focus-visible:px-4 focus-visible:py-2 focus-visible:rounded-md"
    >
      Skip to main content
    </a>

    <Header logoVariant={logoVariant} />

    <main id="main-content" class:list={['relative', !fullBleed && 'lg:ml-[360px]']}>
      <!-- Mobile logo: scrolls with page content; absolute within relative main -->
      <a
        href="/"
        aria-label="Interactivism — home"
        class="lg:hidden absolute top-6 left-6 z-30 block w-20 h-20"
      >
        <img src="/brand/logo-tile.svg" alt="" width="80" height="80" class="w-full h-full" />
      </a>
      {!fullBleed && !hasMarquee && <div class="lg:hidden h-[120px]" aria-hidden="true" />}
      <slot />
    </main>

    <!--
      Mobile footer — shown below main content on mobile/tablet.
      On desktop the footer lives inside the sidenav (Header.astro).
    -->
    {!fullBleed && (
      <footer class="lg:hidden px-6">
        <Footer />
      </footer>
    )}
  </body>

  <script>
    /**
     * Touch-state tracking — suppresses :focus-visible rings that iOS Safari
     * incorrectly fires when .focus() is called programmatically as a result
     * of a touch interaction (e.g. hamburger refocus after menu close, slider
     * heading focus after slide change).
     *
     * html.is-touching → CSS kills the ring for the duration of the touch.
     * Removed 500 ms after touchend to cover any deferred focus() calls.
     * Immediately removed on keydown so keyboard navigation always gets rings.
     */
    let touchTimer: ReturnType<typeof setTimeout> | undefined;

    document.addEventListener('touchstart', () => {
      clearTimeout(touchTimer);
      document.documentElement.classList.add('is-touching');
    }, { passive: true });

    document.addEventListener('touchend', () => {
      touchTimer = setTimeout(() => {
        document.documentElement.classList.remove('is-touching');
      }, 500);
    }, { passive: true });

    document.addEventListener('keydown', () => {
      clearTimeout(touchTimer);
      document.documentElement.classList.remove('is-touching');
    }, { passive: true });
  </script>
</html>
