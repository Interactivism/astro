---
/**
 * Design token reference page.
 * Verifies that Tailwind tokens from DESIGN.md are wired correctly.
 * Not linked from any nav — visit at /design/ during development.
 */
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design tokens — Interactivism</title>
  </head>
  <body class="bg-surface px-8 py-16">

    <header class="mb-16 border-b border-subtle pb-8">
      <p class="font-mono text-sm text-muted mb-2">Interactivism · Design System</p>
      <h1 class="text-5xl font-display leading-display text-headline">Design tokens</h1>
      <p class="text-lg text-muted mt-4">
        This page verifies that every token from DESIGN.md is wired correctly
        into tailwind.config.mjs. Not linked from navigation.
      </p>
    </header>

    <!-- ============================================================
         COLOR PALETTE
         ============================================================ -->
    <section class="mb-20">
      <h2 class="text-2xl font-body font-medium text-headline mb-8">Color — raw palette</h2>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 mb-12">
        <!-- Ink scale -->
        <div>
          <div class="h-16 w-full bg-ink-900 rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">ink-900</p>
          <p class="font-mono text-xs text-muted">#0D0D0D</p>
        </div>
        <div>
          <div class="h-16 w-full bg-ink-700 rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">ink-700</p>
          <p class="font-mono text-xs text-muted">#333333</p>
        </div>
        <div>
          <div class="h-16 w-full bg-ink-500 rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">ink-500</p>
          <p class="font-mono text-xs text-muted">#4A4A4A</p>
        </div>
        <div>
          <div class="h-16 w-full bg-ink-300 rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">ink-300</p>
          <p class="font-mono text-xs text-muted">#CECECE</p>
        </div>

        <!-- Paper scale -->
        <div>
          <div class="h-16 w-full bg-paper-0 rounded-md border border-subtle mb-2"></div>
          <p class="font-mono text-xs text-muted">paper-0</p>
          <p class="font-mono text-xs text-muted">#FEFEFE</p>
        </div>
        <div>
          <div class="h-16 w-full bg-paper-100 rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">paper-100</p>
          <p class="font-mono text-xs text-muted">#F1EFEF</p>
        </div>

        <!-- Brand -->
        <div>
          <div class="h-16 w-full bg-brand-yellow rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">brand-yellow</p>
          <p class="font-mono text-xs text-muted">#F3ED07</p>
        </div>

        <!-- Status -->
        <div>
          <div class="h-16 w-full bg-success rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">success</p>
          <p class="font-mono text-xs text-muted">#27AE74</p>
        </div>
        <div>
          <div class="h-16 w-full bg-info rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">info</p>
          <p class="font-mono text-xs text-muted">#3498EF</p>
        </div>
        <div>
          <div class="h-16 w-full bg-warning rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">warning</p>
          <p class="font-mono text-xs text-muted">#F4D053</p>
        </div>
        <div>
          <div class="h-16 w-full bg-error rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">error</p>
          <p class="font-mono text-xs text-muted">#E74C50</p>
        </div>
      </div>

      <h2 class="text-2xl font-body font-medium text-headline mb-8">Color — semantic tokens</h2>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        <!-- Surface -->
        <div>
          <div class="h-16 w-full bg-surface rounded-md border border-subtle mb-2"></div>
          <p class="font-mono text-xs text-muted">bg-surface</p>
        </div>
        <div>
          <div class="h-16 w-full bg-surface-alt rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">bg-surface-alt</p>
        </div>
        <div>
          <div class="h-16 w-full bg-surface-milk rounded-md border border-subtle mb-2"></div>
          <p class="font-mono text-xs text-muted">bg-surface-milk</p>
          <p class="font-mono text-xs text-muted">paper-0 @ 85%</p>
        </div>

        <!-- Accent states -->
        <div>
          <div class="h-16 w-full bg-accent rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">bg-accent</p>
          <p class="font-mono text-xs text-muted">primary CTA bg</p>
        </div>
        <div>
          <div class="h-16 w-full bg-accent-hover rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">bg-accent-hover</p>
        </div>
        <div>
          <div class="h-16 w-full bg-accent-pressed rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">bg-accent-pressed</p>
        </div>
        <div>
          <div class="h-16 w-full bg-accent-subtle rounded-md mb-2"></div>
          <p class="font-mono text-xs text-muted">bg-accent-subtle</p>
          <p class="font-mono text-xs text-muted">secondary CTA bg</p>
        </div>

        <!-- Border subtle -->
        <div>
          <div class="h-16 w-full rounded-md border-4 border-subtle mb-2"></div>
          <p class="font-mono text-xs text-muted">border-subtle</p>
          <p class="font-mono text-xs text-muted">ink-900 @ 10%</p>
        </div>
      </div>

      <!-- Text colors -->
      <div class="mt-8 space-y-2">
        <p class="text-headline font-medium">text-headline — #0D0D0D (ink-900)</p>
        <p class="text-body">text-body — #333333 (ink-700)</p>
        <p class="text-muted">text-muted — #4A4A4A (ink-500)</p>
        <p class="bg-ink-900 px-4 py-2 rounded-md inline-block">
          <span class="text-inverse">text-inverse — #FEFEFE (paper-0)</span>
        </p>
      </div>
    </section>

    <!-- ============================================================
         TYPE SCALE
         ============================================================ -->
    <section class="mb-20">
      <h2 class="text-2xl font-body font-medium text-headline mb-8">Type scale</h2>

      <div class="space-y-8 border-t border-subtle">

        <div class="pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-xs<br />12px</span>
          <span class="text-xs font-body">Source Sans 3 · 12px · Metadata, eyebrow labels</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-sm<br />14px</span>
          <span class="text-sm font-body">Source Sans 3 · 14px · Captions, fine print</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-base<br />16px</span>
          <span class="text-base font-body">Source Sans 3 · 16px · Body default</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-lg<br />18px</span>
          <span class="text-lg font-body">Source Sans 3 · 18px · Large body, intro paragraphs</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-xl<br />20px</span>
          <span class="text-xl font-body font-medium">Source Sans 3 Medium · 20px · Subheadings (h4)</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-2xl<br />24px</span>
          <span class="text-2xl font-body font-medium">Source Sans 3 Medium · 24px · h3</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-3xl<br />30px</span>
          <span class="text-3xl font-body font-medium">Source Sans 3 · 30px · h2</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-4xl<br />40px</span>
          <span class="text-4xl font-display leading-display">DM Serif Display · 40px · h1 default</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-5xl<br />56px</span>
          <span class="text-5xl font-display leading-display">DM Serif · 56px · Page headline</span>
        </div>

        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">text-6xl<br />72px</span>
          <span class="text-6xl font-display leading-display">DM Serif · 72px · Hero</span>
        </div>

        <!-- Mono -->
        <div class="border-t border-subtle pt-8 flex items-baseline gap-8">
          <span class="font-mono text-xs text-muted w-20 shrink-0">mono<br />14px</span>
          <code class="text-sm font-mono">IBM Plex Mono · code, metadata, timestamps</code>
        </div>

      </div>
    </section>

    <!-- ============================================================
         BUTTONS
         ============================================================ -->
    <section class="mb-20">
      <h2 class="text-2xl font-body font-medium text-headline mb-8">Buttons</h2>

      <div class="flex flex-wrap items-start gap-4">

        <!-- Primary button — accent.surface bg, ink-900 text -->
        <button
          class="bg-accent hover:bg-accent-hover active:bg-accent-pressed
                 text-headline font-body font-medium text-base
                 px-6 py-3 rounded-md
                 transition duration-fast ease-out
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink-900 focus-visible:ring-offset-2"
        >
          Let's Talk
        </button>

        <!-- Secondary button — accent.subtle bg, ink-900 text -->
        <button
          class="bg-accent-subtle hover:bg-ink-300 active:bg-ink-300
                 text-headline font-body font-medium text-base
                 px-6 py-3 rounded-md
                 transition duration-fast ease-out
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink-900 focus-visible:ring-offset-2"
        >
          View Project
        </button>

        <!-- Disabled state -->
        <button
          disabled
          class="bg-accent text-headline font-body font-medium text-base
                 px-6 py-3 rounded-md
                 opacity-50 cursor-not-allowed"
        >
          Disabled
        </button>

      </div>

      <p class="text-sm text-muted mt-6">
        Primary: <code class="font-mono">bg-accent</code> →
        <code class="font-mono">hover:bg-accent-hover</code> →
        <code class="font-mono">active:bg-accent-pressed</code>
      </p>
    </section>

    <!-- ============================================================
         MAX WIDTHS
         ============================================================ -->
    <section class="mb-20">
      <h2 class="text-2xl font-body font-medium text-headline mb-8">Container widths</h2>
      <div class="space-y-4">
        <div class="max-w-content bg-surface-alt rounded-md px-6 py-4">
          <p class="font-mono text-xs text-muted">max-w-content — 1200px — standard page width</p>
        </div>
        <div class="max-w-prose bg-surface-alt rounded-md px-6 py-4">
          <p class="font-mono text-xs text-muted">max-w-prose — 720px — long-form text</p>
        </div>
        <div class="max-w-readable bg-surface-alt rounded-md px-6 py-4">
          <p class="font-mono text-xs text-muted">max-w-readable — 68ch — ~65–75 chars/line</p>
        </div>
      </div>
    </section>

  </body>
</html>
