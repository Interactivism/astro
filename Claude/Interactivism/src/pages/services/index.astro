---
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marquee from '../../components/layout/Marquee.astro';
import CtaBand from '../../components/home/CtaBand.astro';
import PhotoCredit from '../../components/layout/PhotoCredit.astro';
import { getLogoVariant } from '../../lib/imageBrightness';
import marqueeImage from '../../assets/images/marquee/services-mobile.jpg';
import marqueeImageWide from '../../assets/images/marquee/services-wide.jpg';

const allServices = await getCollection('services');
const services = allServices.sort((a, b) => a.data.order - b.data.order);

const marqueeImagePath = path.join(process.cwd(), 'src/assets/images/marquee/services-wide.jpg');
const logoVariant = await getLogoVariant(marqueeImagePath);
---

<BaseLayout
  title="Services"
  description="Digital product design, research, development, and strategy from Interactivism — a studio in Pasadena, CA."
  hasMarquee
  logoVariant={logoVariant}
>
  <Marquee heroImage={marqueeImage} heroImageWide={marqueeImageWide} alt="" />

  <div class="px-6 lg:px-12 py-16 lg:py-24 max-w-content mx-auto">
    <div class="mb-16 lg:mb-24">
      <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">What we do</p>
      <h1 class="font-display leading-display text-headline">
        End-to-end product<br />design and development.
      </h1>
    </div>

    <div class="divide-y divide-subtle">
      {services.map((service) => (
        <div class="py-12 lg:py-16 grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-20">
          <div>
            <h2 class="font-display text-3xl leading-display text-headline">
              {service.data.title}
            </h2>
          </div>
          <div>
            <p class="text-lg text-body leading-body mb-6">
              {service.data.summary}
            </p>
            <a
              href={`/services/${service.id}/`}
              class="inline-flex items-center font-mono text-sm text-muted hover:text-headline transition duration-fast group"
            >
              Learn more
              <span class="ml-2 group-hover:translate-x-1 transition-transform duration-fast">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <PhotoCredit credit='Marquee photo by <a href="https://unsplash.com/@morgansessions?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Morgan Sessions</a> on <a href="https://unsplash.com/photos/woman-standing-on-cliff-YIN4xABaqck?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Unsplash</a>' />
  <CtaBand />
</BaseLayout>
