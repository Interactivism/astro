---
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marquee from '../../components/layout/Marquee.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import CtaBand from '../../components/home/CtaBand.astro';
import PhotoCredit from '../../components/layout/PhotoCredit.astro';
import { getLogoVariant } from '../../lib/imageBrightness';
import marqueeImage from '../../assets/images/marquee/blog-mobile.jpg';
import marqueeImageWide from '../../assets/images/marquee/blog-wide.jpg';

const allPosts = await getCollection('blog');
const now = new Date();
const posts = allPosts
  .filter((p) => p.data.status === 'published' && p.data.publishedDate <= now)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

const marqueeImagePath = path.join(process.cwd(), 'src/assets/images/marquee/blog-wide.jpg');
const logoVariant = await getLogoVariant(marqueeImagePath);
---

<BaseLayout
  title="Blog"
  description="Perspectives on product design, user research, and the craft of building better digital products — from the Interactivism team."
  ogType="website"
  hasMarquee
  logoVariant={logoVariant}
>
  <Marquee heroImage={marqueeImage} heroImageWide={marqueeImageWide} alt="" />

  <div class="px-6 lg:px-12 max-w-content mx-auto">

    <div class="pt-16 lg:pt-24 pb-12 lg:pb-16">
      <p class="font-mono text-xs text-muted uppercase tracking-widest mb-4">Perspectives</p>
      <h1 class="font-display leading-display text-headline">
        Ideas worth<br />chewing on.
      </h1>
    </div>

    {posts.length > 0 ? (
      <div>
        {posts.map((post) => <BlogCard entry={post} />)}
      </div>
    ) : (
      <p class="py-12 text-body text-muted">Posts coming soon.</p>
    )}

  </div>

  <PhotoCredit credit='Marquee photo by <a href="https://unsplash.com/@redzeppelin?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Red Zeppelin</a> on <a href="https://unsplash.com/photos/assorted-title-book-lot-placed-on-white-wooden-shelf-4nulm-JUYFo?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Unsplash</a>' />
  <CtaBand />
</BaseLayout>
