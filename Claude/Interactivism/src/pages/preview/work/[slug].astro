---
/**
 * Preview route for case studies — renders any entry regardless of status or
 * publishedDate. Protected by the preview middleware (password cookie).
 *
 * Mirrors src/pages/work/[slug].astro but:
 *   - SSR (no getStaticPaths)
 *   - Includes draft and future-dated entries
 *   - Shows PreviewBanner
 *   - Omits prev/next navigation (not meaningful across mixed draft/published)
 *   - Skips build-time logo-variant sampling (filesystem not available at SSR runtime)
 */
export const prerender = false;

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Marquee from '../../../components/layout/Marquee.astro';
import PreviewBanner from '../../../components/layout/PreviewBanner.astro';
import PhotoCredit from '../../../components/layout/PhotoCredit.astro';
import CtaBand from '../../../components/home/CtaBand.astro';
import Stat from '../../../components/case-study/Stat.astro';
import StatRow from '../../../components/case-study/StatRow.astro';
import Slideshow from '../../../components/case-study/Slideshow.astro';
import YouTube from '../../../components/case-study/YouTube.astro';
import ImageWithCaption from '../../../components/case-study/ImageWithCaption.astro';
import ImageGrid from '../../../components/case-study/ImageGrid.astro';
import PullQuote from '../../../components/case-study/PullQuote.astro';
import BeforeAfter from '../../../components/case-study/BeforeAfter.astro';
import Aside from '../../../components/case-study/Aside.astro';

// Prevent any CDN or edge cache from serving a stale response.
Astro.response.headers.set('Cache-Control', 'no-store');

const { slug } = Astro.params;

// Get ALL case studies — no status or date filter.
const allCaseStudies = await getCollection('caseStudies');
const entry = allCaseStudies.find((cs) => cs.id === slug);

if (!entry) {
  return Astro.redirect('/404/');
}

const {
  title, client, summary, heroImage, heroImageWide, photoCredit,
  industry, services, year, yearEnd, deliverables, duration, metrics, gallery,
} = entry.data;

const yearDisplay = yearEnd === undefined
  ? String(year)
  : yearEnd === 'present'
    ? `${year}–Present`
    : `${year}–${yearEnd}`;

const { Content } = await render(entry);

// Logo variant: filesystem not available in SSR production; default to 'light'.
// (The placeholder marquee image has a dark background so 'light' logo is correct.)
const logoVariant: 'light' | 'dark' = 'light';

// Photo credit HTML
function buildCredit(pc: typeof photoCredit): string | undefined {
  if (!pc?.photographer) return undefined;
  const name = pc.photographerUrl
    ? `<a href="${pc.photographerUrl}">${pc.photographer}</a>`
    : pc.photographer;
  if (!pc.platform) return `Marquee photo by ${name}`;
  const platform = pc.platformUrl
    ? `<a href="${pc.platformUrl}">${pc.platform}</a>`
    : pc.platform;
  return `Marquee photo by ${name} on ${platform}`;
}
const credit = buildCredit(photoCredit);

const SERVICE_LABELS: Record<string, string> = {
  'product-design':       'Product Design',
  'human-ai-experience':  'Human + AI Experience',
  'user-research':        'User Research',
  'development':          'Development',
  'product-strategy':     'Product Strategy',
  'brand-development':    'Brand Development',
};

const DELIVERABLE_LABELS: Record<string, string> = {
  'ui-ux-design':                 'UI/UX Design',
  'design-system':                'Design System',
  'personas':                     'Personas',
  'usability-assessment':         'Usability Assessment',
  'heuristic-evaluation':         'Heuristic Evaluation',
  'data-visualization':           'Data Visualization',
  'brand-identity':               'Brand Identity',
  'brand-strategy':               'Brand Strategy',
  'illustration':                 'Illustration',
  'animation':                    'Animation',
  'print-collateral':             'Print Collateral',
  'content-strategy':             'Content Strategy',
  'information-architecture':     'Information Architecture',
  'web-development':              'Web Development',
  'mobile':                       'Mobile',
  'native-mobile-app':            'Native Mobile App',
  'futurecasting':                'Futurecasting',
  'augmented-reality-experience': 'Augmented Reality Experience',
  'experience-strategy':          'Experience Strategy',
  'positioning-framework':        'Positioning Framework',
  'messaging-framework':          'Messaging Framework',
  'mobile-app-development':       'Mobile App Development',
};

const INDUSTRY_LABELS: Record<string, string> = {
  'adtech':            'AdTech',
  'aerospace-defense': 'Aerospace & Defense',
  'ai-content':        'AI & Content',
  'consumer':          'Consumer',
  'enterprise-saas':   'Enterprise SaaS',
  'fintech':           'Fintech',
  'martech':           'MarTech',
  'media-publishing':  'Media & Publishing',
  'nonprofit-civic':   'Nonprofit & Civic',
};
---

<BaseLayout
  title={`[Preview] ${client} — ${title}`}
  description={summary}
  ogType="article"
  hasMarquee
  logoVariant={logoVariant}
>

  <PreviewBanner />

  <!-- ── Marquee with client tag ───────────────────────────────── -->
  <div class="relative">
    <Marquee heroImage={heroImage} heroImageWide={heroImageWide} alt="" />
    <div class="absolute bottom-0 left-0 right-0 pb-6 lg:pb-[44px]">
      <div class="px-6 lg:px-12 max-w-content mx-auto">
        <span class="inline-flex items-center bg-ink-900 text-inverse font-mono text-base uppercase tracking-widest px-4 py-1.5">
          {client}
        </span>
      </div>
    </div>
  </div>

  <div class="px-6 lg:px-12 max-w-content mx-auto">

    <!-- ── Title ─────────────────────────────────────────────────── -->
    <h1 class="font-display leading-display text-headline pt-16 lg:pt-24 pb-12 lg:pb-16">
      {title}
    </h1>

    <!-- ── Content grid ──────────────────────────────────────────── -->
    <div class="flex flex-col xl:grid xl:grid-cols-[1fr_280px] xl:gap-20 xl:items-start">

      <!-- Sidebar -->
      <aside class="order-first xl:order-last xl:sticky xl:top-8 xl:self-start
                    border-b border-subtle pb-8 mb-12
                    xl:border-0 xl:pb-0 xl:mb-0 xl:pt-0">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 xl:grid-cols-1 text-sm">
          <div>
            <dt class="font-mono text-xs text-muted uppercase tracking-widest mb-1">Client</dt>
            <dd class="text-headline font-medium">{client}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-muted uppercase tracking-widest mb-1">Industry</dt>
            <dd class="text-body">{INDUSTRY_LABELS[industry] ?? industry}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-muted uppercase tracking-widest mb-1">Services</dt>
            <dd class="text-body space-y-1">
              {services.map((id) => (
                <div>{SERVICE_LABELS[id] ?? id}</div>
              ))}
            </dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-muted uppercase tracking-widest mb-1">Deliverables</dt>
            <dd class="text-body space-y-1">
              {deliverables.map((id) => (
                <div>{DELIVERABLE_LABELS[id] ?? id}</div>
              ))}
            </dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-muted uppercase tracking-widest mb-1">Year</dt>
            <dd class="text-body">{yearDisplay}</dd>
          </div>
          {duration && (
            <div>
              <dt class="font-mono text-xs text-muted uppercase tracking-widest mb-1">Duration</dt>
              <dd class="text-body">{duration}</dd>
            </div>
          )}
        </dl>
      </aside>

      <!-- Main column -->
      <div class="order-last xl:order-first">

        <div class="pb-12 lg:pb-16 border-b border-subtle">
          <p class="text-xl text-body leading-body">{summary}</p>
        </div>

        {metrics && metrics.length > 0 && (
          <div class="py-12 lg:py-16 border-b border-subtle grid grid-cols-2 gap-x-4 gap-y-8 lg:gap-8">
            {metrics.map((m) => (
              <div class="flex flex-col gap-2">
                <span class="font-display text-4xl lg:text-5xl leading-none text-headline">{m.value}</span>
                <span class="font-body text-sm text-muted">{m.label}</span>
              </div>
            ))}
          </div>
        )}

        {gallery && gallery.length > 0 && (
          <div class="py-12 lg:py-16 border-b border-subtle">
            <Slideshow slides={gallery} label={`${client} project gallery`} />
          </div>
        )}

        <div class="py-12 lg:py-16 prose prose-lg lg:prose-xl">
          <Content components={{ Stat, StatRow, Slideshow, YouTube, ImageWithCaption, ImageGrid, PullQuote, BeforeAfter, Aside }} />
        </div>

      </div>
    </div>

  </div>

  <PhotoCredit credit={credit} />
  <CtaBand />

</BaseLayout>
