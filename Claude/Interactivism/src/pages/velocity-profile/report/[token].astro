---
/**
 * /velocity-profile/report/[token] — the web version of the emailed report.
 *
 * Rendered per request: the token is the only key, so there is nothing to
 * prerender and nothing to invalidate when the copy changes in Keystatic.
 *
 * Private by URL, not by auth. The token is 32 random hex characters and the
 * page carries noindex plus an X-Robots-Tag header, but anyone holding the
 * link can read it — which is the point, since people forward these.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/ui/Button.astro';
import { getSubmission } from '../../../lib/velocity-profile/storage';
import { getArchetypeContent } from '../../../lib/velocity-profile/content';
import { buildReplyLink, buildReport } from '../../../lib/velocity-profile/report';
import { resolveCampaign } from '../../../lib/velocity-profile/campaigns';
import { streakPhrase } from '../../../lib/velocity-profile/streak';
import { markFor } from '../../../lib/velocity-profile/marks';

export const prerender = false;

const { token } = Astro.params;

const record = token ? await getSubmission(token) : null;
if (!record) {
  return new Response('Report not found.', {
    status: 404,
    headers: { 'Cache-Control': 'no-store', 'X-Robots-Tag': 'noindex, nofollow' },
  });
}

const report = buildReport(record, await getArchetypeContent());
const mark = markFor(record.results.archetype.primary);
const bookingUrl = '/book?src=velocity-profile-report';

/**
 * The canonical link for sharing. Built from the request so a report shared
 * from a deploy preview keeps pointing at that preview rather than sending a
 * colleague to production, where the token does not exist.
 */
const shareUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const shareSubject = `My team's Velocity Profile: ${report.archetype.name}`;

/**
 * "Send my result" — only for a reader who came in on an invited link and so
 * was never asked for an email. Null for everyone else. The address comes
 * from the environment so the repo does not carry a person's inbox.
 */
const reply = buildReplyLink(
  record,
  report,
  shareUrl,
  process.env.VELOCITY_REPLY_EMAIL || process.env.VELOCITY_NOTIFY_EMAIL || 'hello@interactivism.com',
  resolveCampaign(record.campaign)?.replyPrompt,
);

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const eyebrow = 'font-mono text-xs text-muted uppercase tracking-widest';
const inlineLink =
  'font-light underline decoration-accent decoration-2 underline-offset-4 hover:text-headline transition duration-fast';
---

<BaseLayout
  title={`${report.archetype.name} — Velocity Profile`}
  description="Your Product Velocity Profile report."
  noindex
  analyticsPath="/velocity-profile/report/"
>
  <div
    class="px-6 lg:px-12 py-16 lg:py-24 max-w-content mx-auto"
    id="vp-report"
    data-archetype={report.archetype.name}
    data-offering={report.offering?.name ?? 'none'}
    data-campaign={record.campaign}
  >

    <p class={eyebrow}>Your Velocity Profile</p>

    <div class="w-24 h-24 text-headline mt-6 [&>svg]:w-full [&>svg]:h-full" set:html={mark}></div>

    <h1 class="font-display leading-display text-headline mt-6 mb-2">
      {report.archetype.name}
    </h1>
    <p class="text-lg text-muted leading-body mb-2">{report.archetype.descriptor}</p>
    {report.archetype.secondaryName && (
      <p class={`${eyebrow} mb-6`}>{streakPhrase(report.archetype.secondaryName)}</p>
    )}

    <div class="max-w-prose">
      <p class="text-lg text-body leading-body">{report.intro}</p>

      {report.archetype.settledByTiebreak && (
        <p class="text-sm text-muted leading-body">
          Your answers were close between archetypes, so read the one below as
          the strongest signal rather than the only one.
        </p>
      )}

      {reply && (
        <div class="bg-surface-alt rounded-sm px-6 py-5 mt-8">
          <p class="text-base text-body leading-body">
            Does it ring true? Send us your result and we’ll tell you which of
            the three moves below we’d start with at your company.
          </p>
          <a href={reply.href} data-vp-reply="top" class={inlineLink}>Send my result</a>
          <p class="text-sm text-muted leading-body mt-3">
            Opens an email in your own mail app with your profile and a link to
            this report, so we can read it. Nothing is sent until you press send.
          </p>
        </div>
      )}

      <!-- 1 — What you are good at -->
      <section class="border-t border-subtle pt-8 mt-10">
        <p class={eyebrow}>{report.archetype.strength}</p>
        <h2 class="font-display leading-display text-headline text-3xl mt-3 mb-4">
          What you are good at
        </h2>
        <p class="text-base text-body leading-body">{report.archetype.strengthCopy}</p>
      </section>

      <!-- 2 — Where it breaks down -->
      <section class="border-t border-subtle pt-8 mt-10">
        <h2 class="font-display leading-display text-headline text-3xl mb-4">
          Where it breaks down
        </h2>
        <p class="text-base text-body leading-body">{report.failureMode.copy}</p>

        {report.failureMode.evidence.length > 0 && (
          <div class="bg-surface-alt rounded-sm px-6 py-5 mt-2">
            <p class={`${eyebrow} mb-4`}>In your own answers</p>
            <dl class="space-y-3">
              {report.failureMode.evidence.map((item) => (
                <div>
                  <dt class="text-sm text-muted">{item.prompt}</dt>
                  <dd class="text-base text-headline">{item.answer}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </section>

      <!-- 3 — What it is costing you -->
      {report.cost && (
        <section class="border-t border-subtle pt-8 mt-10" data-vp-section="cost">
          <h2 class="font-display leading-display text-headline text-3xl mb-4">
            What it is costing you
          </h2>

          <p class="font-display leading-display text-headline text-4xl mb-2">
            {report.cost.display}
          </p>
          <p class={`${eyebrow} mb-6`}>a year, in rework</p>

          <p class="text-sm text-muted leading-body">{report.cost.assumptionsLine}</p>
          <p class="text-base text-body leading-body">{report.cost.assumptions}</p>

          {report.cost.unmeasuredNote && (
            <p class="text-base text-body leading-body border-l-2 border-accent pl-5">
              {report.cost.unmeasuredNote}
            </p>
          )}

          {report.cost.flags.length > 0 && (
            <div class="mt-2">
              <p class={`${eyebrow} mb-3`}>Worth a look</p>
              <ul class="space-y-2">
                {report.cost.flags.map((flag) => (
                  <li class="text-base text-body leading-body">
                    <span class="text-headline">{flag.label}</span>
                    <span class="text-muted"> — you said “{flag.answer}”</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}

      <!-- 4 — Your industry -->
      <section class="border-t border-subtle pt-8 mt-10">
        <h2 class="font-display leading-display text-headline text-3xl mb-4">Your industry</h2>
        <p class="text-base text-body leading-body">{report.industryNote}</p>
      </section>

      <!-- 5 — Three moves -->
      <section class="border-t border-subtle pt-8 mt-10" data-vp-section="moves">
        <h2 class="font-display leading-display text-headline text-3xl mb-6">
          Three things that would move the needle
        </h2>
        <ol class="space-y-8">
          {report.moves.map((move, i) => (
            <li>
              <p class={`${eyebrow} mb-2`}>{String(i + 1).padStart(2, '0')}</p>
              <h3 class="text-xl text-headline mb-2">{move.title}</h3>
              <p class="text-base text-body leading-body">{move.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- 6 — Where we come in -->
      {report.offering && (
        <section class="border-t border-subtle pt-8 mt-10">
          <h2 class="font-display leading-display text-headline text-3xl mb-4">
            Where we come in
          </h2>
          <p class={`${eyebrow} mb-3`}>{report.offering.name}</p>
          <p class="text-base text-body leading-body">{report.offering.body}</p>
        </section>
      )}

      <!-- 7 — CTA -->
      <section class="border-t border-subtle pt-8 mt-10" data-vp-section="cta">
        <h2 class="font-display leading-display text-headline text-3xl mb-4">
          Talk it through
        </h2>
        <p class="text-base text-body leading-body">
          Thirty minutes with one of our partners, walking through your results,
          and what we would do first. No deck.
        </p>
        <Button href={bookingUrl} id="vp-report-book">Pick a time</Button>

        {reply && (
          <p class="text-base text-body leading-body mt-6">
            Not ready for a call?
            <a href={reply.href} data-vp-reply="cta" class={inlineLink}>Send my result</a>
            and we’ll reply with where we’d start. The email includes a link to
            this report.
          </p>
        )}
      </section>

      <!-- 8 — Share -->
      <section class="border-t border-subtle pt-8 mt-10">
        <h2 class="font-display leading-display text-headline text-3xl mb-4">
          Send it to someone
        </h2>
        <p class="text-base text-body leading-body">
          Anyone with this link can read the report — no sign-in, nothing to
          install. The three things above are what tend to get forwarded.
        </p>

        <div class="flex items-center gap-4 flex-wrap mt-6">
          <button
            id="vp-share"
            type="button"
            data-url={shareUrl}
            data-title={shareSubject}
            class="font-mono text-xs uppercase tracking-widest text-headline bg-surface-alt border border-subtle rounded-sm px-4 py-3 hover:border-ink-900/30 transition duration-fast"
          >Copy link</button>

          <a
            id="vp-share-email"
            href={`mailto:?subject=${encodeURIComponent(shareSubject)}&body=${encodeURIComponent(`${report.archetype.teaser}\n\n${shareUrl}`)}`}
            class="font-mono text-xs uppercase tracking-widest text-headline bg-surface-alt border border-subtle rounded-sm px-4 py-3 hover:border-ink-900/30 transition duration-fast"
          >Email it</a>

          <p id="vp-share-status" class="font-mono text-xs text-muted" role="status" aria-live="polite"></p>
        </div>

        <!-- Shown only if the clipboard is refused. See the script below. -->
        <input
          id="vp-share-fallback"
          type="text"
          readonly
          hidden
          aria-label="Report link"
          class="w-full bg-surface-alt border border-subtle rounded-sm px-4 py-3 font-mono text-xs text-body mt-3"
        />

        <p class="text-sm text-muted leading-body mt-4">
          Rather it stayed private? <a href="mailto:hello@interactivism.com" class={inlineLink}>Tell us</a> and we will delete it.
        </p>
      </section>

    </div>
  </div>
</BaseLayout>

<script>
  /**
   * Analytics for the report.
   *
   * The funnel used to end the moment someone handed over an email, so nothing
   * said whether the report was read or whether it led anywhere. These events
   * answer three questions: did they open it, how far did they get, and did
   * they act.
   *
   * Sections are named rather than measured as scroll percentages. "Reached
   * the moves" is a question about this document; "scrolled 50%" is a question
   * about pixels, and the answer changes with the length of someone's cost
   * paragraph.
   *
   * The token is never sent. The page overrides page_location through
   * BaseLayout's analyticsPath, because the default page_view would hand
   * Google a working key to a stranger's report.
   */
  const root = document.getElementById('vp-report');

  function track(event: string, params: Record<string, unknown> = {}) {
    const archetype = root?.dataset.archetype;
    const offering = root?.dataset.offering;
    // Present only on a report that came from an invited link. The key names
    // an audience, not a person.
    const campaign = root?.dataset.campaign;
    (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.('event', event, {
      archetype,
      offering,
      ...(campaign ? { campaign } : {}),
      ...params,
    });
  }

  track('vp_report_view');

  // One event per section, the first time it comes into view. A reader who
  // scrolls back up does not fire it twice, so these count people, not passes.
  const sections = document.querySelectorAll<HTMLElement>('[data-vp-section]');
  if (sections.length && 'IntersectionObserver' in window) {
    const seen = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const name = (entry.target as HTMLElement).dataset.vpSection!;
          if (!entry.isIntersecting || seen.has(name)) continue;
          seen.add(name);
          track('vp_report_section', { section: name });
          observer.unobserve(entry.target);
        }
      },
      // Half the section visible, so a heading clipped at the fold does not
      // count as read.
      { threshold: 0.5 },
    );
    for (const section of sections) observer.observe(section);
  }

  document.getElementById('vp-report-book')?.addEventListener('click', () => {
    track('vp_report_book_click');
  });

  // A click, not a sent email: mailto hands off to the reader's mail app and
  // we never learn what happened next. The reply itself is the real signal.
  for (const link of document.querySelectorAll<HTMLElement>('[data-vp-reply]')) {
    link.addEventListener('click', () => {
      track('vp_report_reply_click', { placement: link.dataset.vpReply });
    });
  }

  document.getElementById('vp-share-email')?.addEventListener('click', () => {
    track('vp_report_share', { method: 'email' });
  });

  /**
   * Share: the system share sheet where there is one, clipboard everywhere
   * else. Both paths end at the same place — the link in someone's hands —
   * and neither needs a third-party widget or a tracking pixel.
   *
   * The URL is read from a data attribute rather than location.href so the
   * button shares the canonical report link even if the page was opened with
   * a query string appended by a mail client.
   */
  const button = document.getElementById('vp-share') as HTMLButtonElement | null;
  const status = document.getElementById('vp-share-status');
  const fallback = document.getElementById('vp-share-fallback') as HTMLInputElement | null;

  if (button && status && fallback) {
    const url = button.dataset.url!;
    const title = button.dataset.title!;

    const say = (message: string) => {
      status.textContent = message;
      window.setTimeout(() => { status.textContent = ''; }, 4000);
    };

    // navigator.share needs a user gesture and exists mainly on mobile; the
    // feature test has to run at click time because the sheet can be dismissed,
    // which rejects with AbortError and is not a failure worth reporting.
    button.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
          track('vp_report_share', { method: 'native' });
          return;
        } catch (error) {
          if ((error as Error).name === 'AbortError') return;
        }
      }

      try {
        await navigator.clipboard.writeText(url);
        track('vp_report_share', { method: 'clipboard' });
        say('Link copied.');
      } catch {
        // Clipboard access can be refused outright — an insecure origin, a
        // permissions policy, an unfocused window. Put the URL on screen,
        // selected, so copying is still one keystroke. A hidden field would
        // have been worse than the failure: nothing to copy and nothing to see.
        fallback.hidden = false;
        fallback.value = url;
        fallback.select();
        track('vp_report_share', { method: 'manual' });
        say('Copy it from here:');
      }
    });
  }
</script>
