---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Slider from '../components/home/Slider.astro';
import homepageData from '../data/homepage.json';

// Resolve featured case studies — skip missing or non-published slugs.
const allCaseStudies = await getCollection('caseStudies');
const now = new Date();
const publishedBySlug = new Map(
  allCaseStudies
    .filter((cs) => cs.data.status === 'published' && cs.data.publishedDate <= now)
    .map((cs) => [cs.id, cs])
);
const featuredCaseStudies = homepageData.featuredCaseStudies
  .map((slug) => publishedBySlug.get(slug))
  .filter((cs): cs is NonNullable<typeof cs> => cs !== undefined);
---

<BaseLayout
  title="Digital product design &amp; development"
  description="Interactivism is a digital product design and development studio in Pasadena, CA. We help teams build products that are engaging, efficient, and easy to use."
  fullBleed
  bodyClass="overflow-hidden"
>
  <Slider hero={homepageData.hero} caseStudies={featuredCaseStudies} />
</BaseLayout>
