---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapMarquee from '../../components/contact/MapMarquee.astro';

---

<BaseLayout
  title="Contact"
  description="Start a conversation about your product. We typically respond within one business day."
  hasMarquee
  logoVariant="dark"
>
  <MapMarquee />

  <div class="px-6 lg:px-12 py-16 lg:py-24 max-w-content mx-auto">
    <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">Get in touch</p>
    <h1 class="font-display leading-display text-headline mb-6">
      Let’s talk about<br />your product.
    </h1>
    <p class="text-lg text-body max-w-prose mb-12">
      Tell us what you’re working on. We’ll get back to you within one business day.
    </p>

    <!-- ── Contact form ──────────────────────────────────────────── -->
    <div class="max-w-prose mb-20">

      <!-- Form (hidden after successful submission) -->
      <form
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
        class="space-y-6"
      >
        <!-- Required by Netlify for AJAX submissions -->
        <input type="hidden" name="form-name" value="contact" />

        <!-- Honeypot — hidden from real users, catches bots -->
        <p class="hidden" aria-hidden="true">
          <label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <!-- Name + Email row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label for="name" class="font-mono text-xs text-muted uppercase tracking-widest">
              Name <span aria-hidden="true">*</span>
            </label>
            <input
              type="text" id="name" name="name" required autocomplete="name"
              class="w-full bg-surface-alt border border-subtle rounded-sm px-4 py-3 font-body text-base text-body placeholder:text-ink-300"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="font-mono text-xs text-muted uppercase tracking-widest">
              Email <span aria-hidden="true">*</span>
            </label>
            <input
              type="email" id="email" name="email" required autocomplete="email"
              class="w-full bg-surface-alt border border-subtle rounded-sm px-4 py-3 font-body text-base text-body placeholder:text-ink-300"
            />
          </div>
        </div>

        <!-- Company (optional) -->
        <div class="flex flex-col gap-2">
          <label for="company" class="font-mono text-xs text-muted uppercase tracking-widest">
            Company <span class="normal-case tracking-normal font-body text-xs text-ink-300">(optional)</span>
          </label>
          <input
            type="text" id="company" name="company" autocomplete="organization"
            class="w-full bg-surface-alt border border-subtle rounded-sm px-4 py-3 font-body text-base text-body placeholder:text-ink-300"
          />
        </div>

        <!-- Message -->
        <div class="flex flex-col gap-2">
          <label for="message" class="font-mono text-xs text-muted uppercase tracking-widest">
            What are you working on? <span aria-hidden="true">*</span>
          </label>
          <textarea
            id="message" name="message" required rows="6"
            class="w-full bg-surface-alt border border-subtle rounded-sm px-4 py-3 font-body text-base text-body placeholder:text-ink-300 resize-y min-h-[140px]"
          ></textarea>
        </div>

        <!-- Submit + inline error -->
        <div class="flex items-center gap-6 flex-wrap">
          <button
            id="contact-submit"
            type="submit"
            class="inline-flex items-center bg-accent hover:bg-accent-hover text-headline font-body font-medium text-base px-8 py-4 rounded-sm transition duration-fast disabled:opacity-40 disabled:cursor-not-allowed"
          >
            Send message
          </button>
          <p id="form-error" class="hidden text-error font-mono text-xs" role="alert"></p>
        </div>
      </form>

      <!-- Success state — revealed after submission -->
      <div id="form-success" class="hidden py-2" role="status" aria-live="polite">
        <p class="font-mono text-xs text-muted uppercase tracking-widest mb-3">Message sent</p>
        <p class="text-lg text-body leading-body">
          Thanks — we’ll be in touch within one business day.
        </p>
      </div>

      <!-- Direct contact — address injected by JS, never in HTML source -->
      <div class="mt-10 pt-8 border-t border-subtle space-y-2">
        <p class="text-sm text-muted">Prefer direct contact?</p>
        <a
          id="contact-email"
          href="#"
          class="text-base font-medium text-headline hover:text-muted transition duration-fast underline decoration-accent decoration-2 underline-offset-2"
        ></a>
      </div>

    </div>

    <!-- Scroll-test content — padding out the page height to verify the frozen-slice stays locked -->
    <div class="max-w-prose space-y-16 border-t border-subtle pt-16">
      <div>
        <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">Availability</p>
        <h2 class="font-display text-3xl leading-display text-headline mb-6">Currently booking <span id="booking-quarter"></span></h2>
        <p class="text-body">
          We take on a small number of engagements at a time so we can give each client our full
          attention. If your timeline is urgent, mention it in your message.
        </p>
      </div>

      <div>
        <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">Engagements</p>
        <h2 class="font-display text-3xl leading-display text-headline mb-6">What to expect</h2>
        <p class="text-body">
          Most of our work begins with a fixed-scope discovery sprint. This gives both sides a
          low-risk way to assess fit, surface the real problem, and produce a concrete brief before
          committing to a larger engagement.
        </p>
        <p class="text-body">
          Longer projects are structured around two-week cycles with a standing review at the end
          of each. You’ll always know what we’re working on and why.
        </p>
      </div>

      <div>
        <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">Our process</p>
        <h2 class="font-display text-3xl leading-display text-headline mb-6">How we work</h2>
        <p class="text-body">
          We start every engagement with a discovery phase — listening closely to understand your
          users, your constraints, and your definition of success. From there we move into rapid
          concept exploration, sharing work early and often so nothing is wasted.
        </p>
        <p class="text-body">
          Once a direction is validated we shift into delivery: high-fidelity design, component
          development, and integration support. We stay close through launch and beyond – because “finished” is not in our vocabulary, and it shouldn’t be in yours.
        </p>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  // Booking quarter — always one quarter ahead of today, computed at runtime
  const bqEl = document.getElementById('booking-quarter');
  if (bqEl) {
    const now = new Date();
    const currentQ = Math.floor(now.getMonth() / 3) + 1;
    const nextQ = currentQ === 4 ? 1 : currentQ + 1;
    const nextQYear = currentQ === 4 ? now.getFullYear() + 1 : now.getFullYear();
    bqEl.textContent = `Q${nextQ} ${nextQYear}`;
  }

  // Assemble email address at runtime — keeps it out of HTML source
  const emailEl = document.getElementById('contact-email') as HTMLAnchorElement | null;
  if (emailEl) {
    const addr = ['hello', 'interactivism.com'].join('@');
    emailEl.href = `mailto:${addr}`;
    emailEl.textContent = addr;
  }

  const form    = document.getElementById('contact-form')    as HTMLFormElement   | null;
  const submit  = document.getElementById('contact-submit')  as HTMLButtonElement | null;
  const errorEl = document.getElementById('form-error')      as HTMLElement       | null;
  const success = document.getElementById('form-success')    as HTMLElement       | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Reset error state
    if (errorEl) { errorEl.textContent = ''; errorEl.classList.add('hidden'); }

    // Loading state
    if (submit) { submit.disabled = true; submit.textContent = 'Sending…'; }

    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form!)).toString(),
      });

      if (res.ok) {
        form!.classList.add('hidden');
        success?.classList.remove('hidden');
      } else {
        throw new Error(`${res.status}`);
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = 'Something went wrong — please try again or email us directly.';
        errorEl.classList.remove('hidden');
      }
      if (submit) { submit.disabled = false; submit.textContent = 'Send message'; }
    }
  });
</script>
