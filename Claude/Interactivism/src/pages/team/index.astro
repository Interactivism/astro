---
import path from 'node:path';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marquee from '../../components/layout/Marquee.astro';
import CtaBand from '../../components/home/CtaBand.astro';
import PhotoCredit from '../../components/layout/PhotoCredit.astro';
import { getLogoVariant } from '../../lib/imageBrightness';
import marqueeImage from '../../assets/images/marquee/team-mobile.jpg';
import marqueeImageWide from '../../assets/images/marquee/team-wide.jpg';

// Current team members only (order is set); excludes studio byline and alumni
const allAuthors = await getCollection('authors');
const team = allAuthors
  .filter((a) => a.id !== 'interactivism' && a.data.order !== undefined)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const marqueeImagePath = path.join(process.cwd(), 'src/assets/images/marquee/team-wide.jpg');
const logoVariant = await getLogoVariant(marqueeImagePath);
---

<BaseLayout
  title="Team"
  description="Interactivism is a small studio led by Erik Wingren and Petra Wennberg, with a team of designers, researchers, and engineers in Pasadena, CA."
  hasMarquee
  logoVariant={logoVariant}
>
  <Marquee heroImage={marqueeImage} heroImageWide={marqueeImageWide} alt="" />

  <div class="px-6 lg:px-12 max-w-content mx-auto">

    <!-- ── Intro ───────────────────────────────────────────────── -->
    <div class="pt-16 lg:pt-24 pb-16 lg:pb-24 border-b border-subtle">
      <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">The studio</p>
      <h1 class="font-display leading-display text-headline mb-10 max-w-[20ch]">
        Small team,<br />serious work.
      </h1>
      <div class="max-w-prose space-y-5 text-lg text-body leading-body">
        <p>
          We work in small, focused, top-heavy teams. The people you meet in the first conversations are the people who do the work. We don’t staff projects with junior talent and supervisor reviews. Our work has helped create more than $3B in client exits.
        </p>
      </div>
    </div>

    <!-- ── Team members ────────────────────────────────────────── -->
    <div class="py-16 lg:py-24">
      {team.length > 0 ? (
        <div class="divide-y divide-subtle">
          {team.map((member) => (
            <div class="py-12 lg:py-16 grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-8 lg:gap-16 items-start">
              <!-- Avatar -->
              <a href={`/team/${member.id}/`} class="block group shrink-0 w-32 lg:w-full overflow-hidden rounded-sm">
                <Image
                  src={member.data.avatar}
                  alt={member.data.name}
                  width={400}
                  height={400}
                  class="w-32 h-32 lg:w-full lg:h-auto lg:aspect-square object-cover transition duration-DEFAULT group-hover:scale-[1.03]"
                />
              </a>

              <!-- Bio -->
              <div>
                <div class="mb-4">
                  <a href={`/team/${member.id}/`} class="hover:text-muted transition duration-fast">
                    <h2 class="font-display text-3xl leading-display text-headline">
                      {member.data.name}
                    </h2>
                  </a>
                  <p class="font-mono text-xs text-muted uppercase tracking-widest mt-1">
                    {member.data.role}
                  </p>
                </div>
                <p class="text-base text-body leading-body max-w-prose mb-6">
                  {member.data.bio.length > 320
                    ? member.data.bio.slice(0, 320).trimEnd() + '…'
                    : member.data.bio}
                </p>
                <div class="flex items-center gap-4 flex-wrap">
                  {member.data.social?.linkedin && (
                    <a
                      href={member.data.social.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="LinkedIn"
                      class="text-muted hover:text-headline transition duration-fast"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                    </a>
                  )}
                  {member.data.social?.medium && (
                    <a
                      href={member.data.social.medium}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Medium"
                      class="text-muted hover:text-headline transition duration-fast"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
                      </svg>
                    </a>
                  )}
                  {member.data.social?.instagram && (
                    <a
                      href={member.data.social.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Instagram"
                      class="text-muted hover:text-headline transition duration-fast"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                      </svg>
                    </a>
                  )}
                  {member.data.social?.website && (
                    <a
                      href={member.data.social.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Website"
                      class="text-muted hover:text-headline transition duration-fast"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
                      </svg>
                    </a>
                  )}
                  <a
                    href={`/team/${member.id}/`}
                    class="font-mono text-xs text-muted hover:text-headline transition duration-fast group"
                  >
                    Full bio <span class="group-hover:translate-x-1 inline-block transition-transform duration-fast">→</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-body text-muted">Team profiles coming soon.</p>
      )}
    </div>

  </div>

  <PhotoCredit credit='Marquee photo by <a href="https://unsplash.com/@derstudi?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Timon Studler</a> on <a href="https://unsplash.com/photos/people-walking-on-grey-concrete-floor-during-daytime-ABGaVhJxwDQ?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Unsplash</a>' />
  <CtaBand />
</BaseLayout>
