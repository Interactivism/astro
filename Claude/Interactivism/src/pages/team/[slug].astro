---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/home/CtaBand.astro';

export async function getStaticPaths() {
  const allAuthors = await getCollection('authors');
  return allAuthors
    .filter((a) => a.id !== 'interactivism')
    .map((author) => ({
      params: { slug: author.id },
      props: { author },
    }));
}

const { author } = Astro.props;
const { name, role, bio, avatar, social } = author.data;
---

<BaseLayout
  title={name}
  description={bio}
>
  <div class="px-6 max-w-content mx-auto">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <div class="pt-16 lg:pt-24 pb-12 lg:pb-16 border-b border-subtle">
      <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">
        <a href="/team/" class="hover:text-headline transition duration-fast">Team</a>
        {' '}/ {name}
      </p>

      <div class="flex flex-col lg:flex-row gap-8 lg:gap-16 lg:items-start">
        <!-- Avatar -->
        <div class="shrink-0">
          <Image
            src={avatar}
            alt={name}
            width={400}
            height={400}
            class="w-32 h-32 lg:w-48 lg:h-48 object-cover rounded-sm"
          />
        </div>

        <!-- Name + role + social -->
        <div class="flex flex-col justify-center">
          <h1 class="font-display leading-display text-headline mb-2">
            {name}
          </h1>
          <p class="font-mono text-xs text-muted uppercase tracking-widest mb-6">{role}</p>
          <div class="flex items-center gap-5 flex-wrap">
            {social?.linkedin && (
              <a
                href={social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs text-muted uppercase tracking-widest hover:text-headline transition duration-fast"
              >
                LinkedIn
              </a>
            )}
            {social?.medium && (
              <a
                href={social.medium}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs text-muted uppercase tracking-widest hover:text-headline transition duration-fast"
              >
                Medium
              </a>
            )}
            {social?.instagram && (
              <a
                href={social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs text-muted uppercase tracking-widest hover:text-headline transition duration-fast"
              >
                Instagram
              </a>
            )}
            {social?.website && (
              <a
                href={social.website}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs text-muted uppercase tracking-widest hover:text-headline transition duration-fast"
              >
                Website
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- ── Bio ─────────────────────────────────────────────────── -->
    <div class="py-16 lg:py-24 max-w-prose space-y-5">
      {bio.split('\n\n').map((paragraph) => (
        <p class="text-xl text-body leading-body">{paragraph}</p>
      ))}
    </div>

  </div>

  <CtaBand />
</BaseLayout>
