---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/home/CtaBand.astro';

export async function getStaticPaths() {
  const allAuthors = await getCollection('authors');
  return allAuthors
    .filter((a) => a.id !== 'interactivism')
    .map((author) => ({
      params: { slug: author.id },
      props: { author },
    }));
}

const { author } = Astro.props;
const { name, role, bio, avatar, social } = author.data;
---

<BaseLayout
  title={name}
  description={bio}
>
  <div class="px-6 lg:px-12 max-w-content mx-auto">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <div class="pt-16 lg:pt-24 pb-12 lg:pb-16 border-b border-subtle">
      <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">
        <a href="/team/" class="hover:text-headline transition duration-fast">Team</a>
        {' '}/ {name}
      </p>

      <div class="flex flex-col lg:flex-row gap-8 lg:gap-16 lg:items-start">
        <!-- Avatar -->
        <div class="shrink-0">
          <Image
            src={avatar}
            alt={name}
            width={400}
            height={400}
            class="w-32 h-32 lg:w-48 lg:h-48 object-cover rounded-sm"
          />
        </div>

        <!-- Name + role + social -->
        <div class="flex flex-col justify-center">
          <h1 class="font-display leading-display text-headline mb-2">
            {name}
          </h1>
          <p class="font-mono text-xs text-muted uppercase tracking-widest mb-6">{role}</p>
          <div class="flex items-center gap-4 flex-wrap">
            {social?.linkedin && (
              <a
                href={social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="text-muted hover:text-headline transition duration-fast"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            )}
            {social?.medium && (
              <a
                href={social.medium}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Medium"
                class="text-muted hover:text-headline transition duration-fast"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M9.025 8c0 2.49-1.8 4.5-4.013 4.5S1 10.49 1 8s1.8-4.5 4.012-4.5S9.025 5.51 9.025 8zm4.4 0c0 2.34-1.8 4.235-1.8 4.235S9.825 10.34 9.825 8s1.8-4.235 1.8-4.235S13.425 5.66 13.425 8zm.575 0c0 2.075-.71 3.757-.71 3.757S13.29 10.075 13.29 8s.71-3.757.71-3.757S14 5.925 14 8z"/>
                </svg>
              </a>
            )}
            {social?.instagram && (
              <a
                href={social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="text-muted hover:text-headline transition duration-fast"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 1.44c2.136 0 2.389.009 3.233.047 2.152.098 3.175 1.14 3.273 3.273.038.844.046 1.097.046 3.233s-.009 2.389-.046 3.233c-.099 2.13-1.12 3.175-3.273 3.273-.844.038-1.096.046-3.233.046s-2.39-.008-3.233-.046C2.613 13.404 1.59 12.36 1.492 10.23 1.454 9.388 1.445 9.136 1.445 8s.009-2.389.047-3.233C1.59 2.535 2.614 1.49 4.767 1.487c.844-.038 1.097-.047 3.233-.047zM8 0C5.827 0 5.555.01 4.702.048 1.896.178.178 1.895.048 4.702.01 5.555 0 5.827 0 8c0 2.173.01 2.445.048 3.298.13 2.807 1.847 4.524 4.654 4.654C5.555 15.99 5.827 16 8 16s2.445-.01 3.298-.048c2.802-.13 4.524-1.847 4.654-4.654C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.298c-.13-2.804-1.845-4.524-4.654-4.654C10.445.01 10.173 0 8 0zm0 3.892a4.108 4.108 0 1 0 0 8.216 4.108 4.108 0 0 0 0-8.216zm0 6.77A2.663 2.663 0 1 1 8 5.33a2.663 2.663 0 0 1 0 5.331zm5.23-6.937a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92z"/>
                </svg>
              </a>
            )}
            {social?.website && (
              <a
                href={social.website}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Website"
                class="text-muted hover:text-headline transition duration-fast"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="8" cy="8" r="6.5"/>
                  <path d="M8 1.5C6.5 3.5 5.5 5.6 5.5 8s1 4.5 2.5 6.5M8 1.5C9.5 3.5 10.5 5.6 10.5 8s-1 4.5-2.5 6.5"/>
                  <path d="M1.5 8h13"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- ── Bio ─────────────────────────────────────────────────── -->
    <div class="py-16 lg:py-24 max-w-prose space-y-5">
      {bio.split('\n\n').map((paragraph) => (
        <p class="text-xl text-body leading-body">{paragraph}</p>
      ))}
    </div>

  </div>

  <CtaBand />
</BaseLayout>
