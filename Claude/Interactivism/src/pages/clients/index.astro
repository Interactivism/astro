---
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marquee from '../../components/layout/Marquee.astro';
import CtaBand from '../../components/home/CtaBand.astro';
import PhotoCredit from '../../components/layout/PhotoCredit.astro';
import { getLogoVariant } from '../../lib/imageBrightness';
import marqueeImage from '../../assets/images/marquee/clients-mobile.jpg';
import marqueeImageWide from '../../assets/images/marquee/clients-wide.jpg';
import clientsData from '../../data/clients.json';

const marqueeImagePath = path.join(process.cwd(), 'src/assets/images/marquee/clients-wide.jpg');
const logoVariant = await getLogoVariant(marqueeImagePath);

const clients = clientsData as { name: string; href?: string; suffix?: string }[];
---

<BaseLayout
  title="Clients"
  description="From early-stage startups to Fortune 500 teams — a selection of the clients Interactivism has worked with since 2008."
  hasMarquee
  logoVariant={logoVariant}
>
  <Marquee heroImage={marqueeImage} heroImageWide={marqueeImageWide} alt="" />

  <div class="px-6 lg:px-12 max-w-content mx-auto">

    <!-- ── Intro ───────────────────────────────────────────────── -->
    <div class="pt-16 lg:pt-24 pb-16 lg:pb-24 border-b border-subtle">
      <p class="font-mono text-xs text-muted mb-4 uppercase tracking-widest">Since 2008</p>
      <h1 class="font-display leading-display text-headline mb-10 max-w-[18ch]">
        From early-stage<br />to Fortune 500.
      </h1>
      <p class="text-lg text-body leading-body max-w-prose">
        We’ve worked with remarkable companies across industries — seed-stage startups finding product-market fit, scale-ups racing to ship, and enterprise teams rethinking legacy products. The teams we remember best aren’t the biggest ones — they’re the ones who care about the work as much as we do.
      </p>
    </div>

    <!-- ── Client list ─────────────────────────────────────────── -->
    <div class="py-16 lg:py-24">
      <ul
        class="grid grid-cols-1 lg:grid-cols-2"
        role="list"
        aria-label="Client list"
      >
        {clients.map(({ name, href, suffix }) => (
          <li class="py-3 pr-8 border-b border-subtle font-body text-base text-body">
            {href ? (
              <a href={href} class="hover:text-headline transition duration-fast">
                {name}
              </a>
            ) : name}
            {suffix && <span class="text-muted"> {suffix}</span>}
          </li>
        ))}
      </ul>
    </div>

  </div>

  <PhotoCredit credit='Marquee photo by <a href="https://unsplash.com/@clementdelhaye?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Clement Delhaye</a> on <a href="https://unsplash.com/photos/person-in-red-jacket-riding-on-snow-board-during-daytime-Zzde4WYo4HY?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Unsplash</a>' />
  <CtaBand />
</BaseLayout>
