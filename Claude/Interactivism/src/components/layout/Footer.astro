---
/**
 * Footer content — contact info, social links, copyright.
 * Rendered in two contexts:
 *   1. Inside the desktop sidenav (via Header.astro), bottom of the nav column.
 *   2. Standalone at the bottom of the page body on mobile.
 * Visibility toggling between the two is handled by the parent (BaseLayout).
 */
const year = new Date().getFullYear();
---

<div class="space-y-6 py-8 px-8">
  <!-- Contact info -->
  <div class="space-y-1">
    <a
      href="tel:+13233255080"
      class="block text-sm text-muted hover:text-headline transition duration-fast"
    >
      +1-323-325-5080
    </a>
    <p class="text-sm text-muted leading-snug">
      40 E. Colorado Blvd, Suite A<br />
      Pasadena, CA 91105
    </p>
  </div>

  <!-- Social icons -->
  <div class="flex items-center gap-4">
    <!-- Instagram -->
    <a
      href="https://www.instagram.com/interactivism/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Interactivism on Instagram"
      class="text-ink-900 hover:text-accent transition duration-fast"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
      </svg>
    </a>

    <!-- Medium -->
    <a
      href="https://medium.com/@interactivismco"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Interactivism on Medium"
      class="text-ink-900 hover:text-accent transition duration-fast"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"
        />
      </svg>
    </a>

    <!-- LinkedIn -->
    <a
      href="https://www.linkedin.com/company/interactivism"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Interactivism on LinkedIn"
      class="text-ink-900 hover:text-accent transition duration-fast"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        />
      </svg>
    </a>
  </div>

  <!-- Copyright -->
  <p class="text-xs text-muted">
    &copy; {year} Interactivism
  </p>
</div>
