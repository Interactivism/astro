---
/**
 * Page marquee — full-bleed image header for all non-homepage pages.
 *
 * Mobile  (<lg): heroImage (16:9), scrolls naturally with page content.
 *                The mobile logo (absolute top-6 left-6 in BaseLayout) overlaps
 *                the top-left corner of the marquee.
 *
 * Desktop (lg+): heroImageWide (4:1), full viewport width.
 *                The marquee extends left past the sidenav via w-screen + -ml-[360px].
 *                The sidenav's transparent 200×200 logo window (inset-20 within the
 *                360px-tall knockout block) reveals the page background behind it.
 *
 *                Frozen-slice effect: a fixed viewport-locked window at the logo
 *                silhouette position (left:80px top:80px, 200×200px) holds a copy of
 *                the wide image sized to cover the full viewport. This creates the
 *                illusion that the logo wordmark is a cutout into the marquee image
 *                even after the marquee has scrolled away.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** 16:9 image — shown on mobile. Shows placeholder when omitted. */
  heroImage?: ImageMetadata;
  /** 4:1 image — shown on desktop. Shows placeholder when omitted. */
  heroImageWide?: ImageMetadata;
  /** Decorative alt text (empty by default) */
  alt?: string;
}

const { heroImage, heroImageWide, alt = '' } = Astro.props;

// Resolve a URL for the frozen-slice <img> (which uses raw CSS sizing).
// Falls back to the wide placeholder SVG when no image is set.
const frozenSrc = heroImageWide
  ? (await getImage({ src: heroImageWide })).src
  : '/placeholders/hero-wide-placeholder.svg';
---

<!--
  Marquee wrapper.
  Mobile:  aspect-[16/9], full width, normal flow.
  Desktop: aspect-[4/1],  viewport width via w-screen + -ml-[360px].
           overflow-hidden clips the negative-margin shift.
-->
<div class="w-full overflow-hidden lg:w-screen lg:-ml-[360px] aspect-[16/9] lg:aspect-[4/1] lg:min-h-[300px] relative">
  <!-- Mobile image (16:9) — real image or placeholder -->
  {heroImage ? (
    <Image
      src={heroImage}
      alt={alt}
      width={900}
      height={506}
      class="lg:hidden absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  ) : (
    <img
      src="/placeholders/hero-placeholder.svg"
      alt=""
      class="lg:hidden absolute inset-0 w-full h-full object-cover"
      aria-hidden="true"
    />
  )}
  <!-- Desktop image (4:1) — real image or placeholder -->
  {heroImageWide ? (
    <Image
      src={heroImageWide}
      alt={alt}
      width={2400}
      height={600}
      class="hidden lg:block absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  ) : (
    <img
      src="/placeholders/hero-wide-placeholder.svg"
      alt=""
      class="hidden lg:block absolute inset-0 w-full h-full object-cover"
      aria-hidden="true"
    />
  )}
</div>

<!--
  Frozen-slice — desktop only.
  A fixed viewport-locked window at exactly the logo silhouette position
  (left:80px top:80px, 200×200 px = inset-20 of the 360px knockout block).
  The wide image is sized to 100vw × 25vw so it mirrors the main marquee's
  object-cover behaviour at any viewport width. The -80px offsets align the
  image's top-left corner with viewport (0,0), making the clip window show
  exactly viewport region (80–280, 80–280).

  z-30: above main content, below the sidenav (z-40).
  pointer-events-none: never intercepts clicks.
-->
<div
  class="hidden lg:block fixed overflow-hidden pointer-events-none z-30"
  style="left: 80px; top: 80px; width: 200px; height: 200px;"
  aria-hidden="true"
>
  <img
    src={frozenSrc}
    alt=""
    style="position: absolute; width: 100vw; max-width: none; height: max(25vw, 300px); left: -80px; top: -80px; object-fit: cover;"
  />
</div>
