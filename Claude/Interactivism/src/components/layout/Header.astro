---
/**
 * Site header — two distinct treatments by viewport.
 *
 * Desktop (lg+): fixed sidenav, 360px wide.
 *   - Top 360px: knockout block — four surface-alt panels around a transparent
 *     200×200 center (80px margin all sides) where logo-light renders.
 *     The page background (slider, marquee) shows through the transparent area.
 *   - Below: nav + footer, both with surface-alt bg, left-aligned to logo edge (pl-20).
 *
 * Mobile (<lg): no floating header — logo lives in BaseLayout <main> and scrolls
 *   with page content. Only a standalone fixed hamburger button (z-[70]) appears
 *   top-right. Tap → full-screen overlay with logo at same top-left position,
 *   nav centered vertically + horizontally, footer at bottom.
 */
import Footer from './Footer.astro';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Services', href: '/services/' },
  { label: 'Work', href: '/work/' },
  { label: 'Clients', href: '/clients/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Team', href: '/team/' },
  { label: 'Contact', href: '/contact/' },
] as const;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<!-- ============================================================
     Desktop sidenav — hidden below lg
     ============================================================ -->
<aside
  class="hidden lg:flex flex-col fixed left-0 top-0 h-full w-[360px] z-40 overflow-y-auto"
  aria-label="Site navigation"
>
  <!-- Knockout block: 360×360 container.
       Four surface-alt panels leave a transparent 200×200 center (inset 80px = 5rem).
       logo-light renders at absolute inset-20 so the page behind shows through. -->
  <div class="relative shrink-0" style="height:360px">
    <div class="absolute top-0 left-0 right-0 h-20 bg-surface-alt" />
    <div class="absolute bottom-0 left-0 right-0 h-20 bg-surface-alt" />
    <div class="absolute top-20 bottom-20 left-0 w-20 bg-surface-alt" />
    <div class="absolute top-20 bottom-20 right-0 w-20 bg-surface-alt" />
    <a href="/" aria-label="Interactivism — home" class="absolute inset-20 z-10 block">
      <img src="/brand/logo-light.svg" alt="" class="w-full h-full" />
    </a>
  </div>

  <!-- Nav: surface-alt bg, left edge aligns with logo left edge (pl-20 = 80px) -->
  <nav class="flex-1 bg-surface-alt pl-20 pr-10 pt-8" aria-label="Primary navigation">
    <ul class="flex flex-col" role="list">
      {
        navItems.map(({ label, href }) => {
          const active = isActive(href);
          return (
            <li>
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex items-center py-3 font-body font-medium text-2xl text-headline',
                  'transition duration-fast hover:text-muted',
                  active && 'text-muted',
                ]}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <!-- Footer: left edge aligns with logo left edge (pl-20 = 80px) -->
  <div class="bg-surface-alt pl-20 pr-20 pb-8">
    <Footer />
  </div>
</aside>

<!-- ============================================================
     Mobile hamburger — standalone fixed, z-[70] above overlay
     Icon crossfades between menu and X on open/close
     ============================================================ -->
<button
  id="mobile-nav-toggle"
  type="button"
  aria-expanded="false"
  aria-controls="mobile-nav-overlay"
  aria-label="Open navigation menu"
  class="lg:hidden fixed top-6 right-6 z-[70] w-[40px] h-[40px] flex items-center justify-center rounded-sm text-ink-900 transition duration-fast"
  style="background-color: rgba(254, 254, 254, 0.25);"
>
  <span class="relative w-6 h-6">
    <svg
      id="icon-menu"
      class="absolute inset-0 transition-opacity duration-150"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
    <svg
      id="icon-close"
      class="absolute inset-0 opacity-0 transition-opacity duration-150"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </span>
</button>

<!-- ============================================================
     Mobile nav overlay — z-[60], below hamburger
     Logo at top-4 left-4 mirrors the page logo position.
     Nav centered vertically + horizontally in the overlay.
     ============================================================ -->
<div
  id="mobile-nav-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  class="hidden lg:hidden fixed inset-0 z-[60] flex-col bg-surface-milk"
>
  <!-- Logo: same absolute position as the page logo in BaseLayout -->
  <a href="/" aria-label="Interactivism — home" class="absolute top-6 left-6 z-10 block w-20 h-20">
    <img src="/brand/logo-tile.svg" alt="" width="80" height="80" class="w-full h-full" />
  </a>

  <!-- Nav: centered vertically + horizontally -->
  <nav class="flex-1 flex items-center justify-center" aria-label="Primary navigation">
    <ul class="flex flex-col items-center w-full" role="list">
      {
        navItems.map(({ label, href }) => {
          const active = isActive(href);
          return (
            <li class="w-full text-center">
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex items-center justify-center min-h-[44px] py-3',
                  'font-body font-medium text-2xl transition duration-fast',
                  active ? 'text-muted' : 'text-headline hover:text-muted',
                ]}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <!-- Footer at bottom of overlay -->
  <div class="px-6 pb-8">
    <Footer />
  </div>
</div>

<script>
  const toggle   = document.getElementById('mobile-nav-toggle') as HTMLButtonElement | null;
  const overlay  = document.getElementById('mobile-nav-overlay') as HTMLElement | null;
  const iconMenu  = document.getElementById('icon-menu') as SVGElement | null;
  const iconClose = document.getElementById('icon-close') as SVGElement | null;

  if (toggle && overlay) {
    function openNav() {
      overlay!.classList.remove('hidden');
      overlay!.classList.add('flex');
      toggle!.setAttribute('aria-expanded', 'true');
      toggle!.setAttribute('aria-label', 'Close navigation menu');
      iconMenu?.classList.add('opacity-0');
      iconClose?.classList.remove('opacity-0');
      document.body.style.overflow = 'hidden';
    }

    function closeNav() {
      overlay!.classList.remove('flex');
      overlay!.classList.add('hidden');
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', 'Open navigation menu');
      iconMenu?.classList.remove('opacity-0');
      iconClose?.classList.add('opacity-0');
      document.body.style.overflow = '';
      toggle!.focus();
    }

    toggle.addEventListener('click', () => {
      overlay!.classList.contains('flex') ? closeNav() : openNav();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay!.classList.contains('flex')) closeNav();
    });

    overlay.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeNav());
    });
  }
</script>
