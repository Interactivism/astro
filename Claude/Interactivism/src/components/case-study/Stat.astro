---
/**
 * Single large metric — value + label.
 * Used standalone or grouped inside <StatRow>.
 */
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="flex flex-col gap-2">
  <span class="font-display text-5xl leading-none text-headline">{value}</span>
  <span class="font-body text-sm text-muted">{label}</span>
</div>
