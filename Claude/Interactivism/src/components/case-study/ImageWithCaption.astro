---
/**
 * Single image with optional caption.
 * Accepts both imported ImageMetadata (astro:assets) and string paths (public/).
 *
 * Usage in MDX:
 *   import screen from './screen.png';
 *   <ImageWithCaption src={screen} alt="Dashboard redesign" caption="The new dashboard at launch." />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="not-prose my-10 lg:my-12">
  <div class="bg-surface-alt overflow-hidden">
    {typeof src === 'string' ? (
      <img src={src} alt={alt} class="w-full h-auto" loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} class="w-full h-auto" />
    )}
  </div>
  {caption && (
    <figcaption class="mt-3 text-sm text-muted italic">{caption}</figcaption>
  )}
</figure>
