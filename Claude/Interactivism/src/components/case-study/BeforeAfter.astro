---
/**
 * Side-by-side before/after image comparison.
 * Stacks vertically on mobile, 2-column on sm+.
 * Labels default to "Before" / "After" but can be overridden.
 *
 * Usage in MDX:
 *   import before from './dashboard-before.png';
 *   import after  from './dashboard-after.png';
 *   <BeforeAfter before={before} after={after} alt="Dashboard redesign" />
 *
 *   <BeforeAfter
 *     before={before} after={after}
 *     beforeLabel="v1" afterLabel="v2"
 *     alt="Navigation redesign"
 *   />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata | string;
  after: ImageMetadata | string;
  alt?: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  before,
  after,
  alt = '',
  beforeLabel = 'Before',
  afterLabel = 'After',
} = Astro.props;
---

<div class="not-prose my-10 lg:my-12 grid grid-cols-1 sm:grid-cols-2 gap-4">
  <figure>
    <div class="bg-surface-alt overflow-hidden">
      {typeof before === 'string' ? (
        <img src={before} alt={`${beforeLabel}${alt ? `: ${alt}` : ''}`} class="w-full h-auto" loading="lazy" decoding="async" />
      ) : (
        <Image src={before} alt={`${beforeLabel}${alt ? `: ${alt}` : ''}`} class="w-full h-auto" />
      )}
    </div>
    <figcaption class="mt-2 font-mono text-xs text-muted uppercase tracking-widest">
      {beforeLabel}
    </figcaption>
  </figure>

  <figure>
    <div class="bg-surface-alt overflow-hidden">
      {typeof after === 'string' ? (
        <img src={after} alt={`${afterLabel}${alt ? `: ${alt}` : ''}`} class="w-full h-auto" loading="lazy" decoding="async" />
      ) : (
        <Image src={after} alt={`${afterLabel}${alt ? `: ${alt}` : ''}`} class="w-full h-auto" />
      )}
    </div>
    <figcaption class="mt-2 font-mono text-xs text-muted uppercase tracking-widest">
      {afterLabel}
    </figcaption>
  </figure>
</div>
