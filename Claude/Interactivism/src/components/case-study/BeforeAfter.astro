---
/**
 * Drag-to-reveal before/after image comparison slider.
 * Before is on the left, after is on the right. Drag the divider to reveal.
 *
 * Usage in MDX:
 *   <BeforeAfter
 *     before="/images/slug/dashboard-before.jpg"
 *     after="/images/slug/dashboard-after.jpg"
 *     alt="Dashboard redesign"
 *   />
 *
 * Both images should have the same dimensions.
 * Images must be served from public/ using absolute /images/... paths —
 * relative ./... paths resolve as broken browser-relative URLs at runtime.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata | string;
  after: ImageMetadata | string;
  alt?: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  before,
  after,
  alt = '',
  beforeLabel = 'Before',
  afterLabel = 'After',
} = Astro.props;

// Render nothing if images are missing (e.g. Keystatic stripped props during a save)
if (!before || !after) return;

const id = `ba-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="not-prose my-10 lg:my-12" data-before-after id={id}>
  <div
    class="relative overflow-hidden select-none cursor-col-resize bg-surface-alt"
    data-ba-container
  >
    <!-- After image — base layer, establishes natural container height -->
    {typeof after === 'string' ? (
      <img
        src={after}
        alt={`${afterLabel}${alt ? `: ${alt}` : ''}`}
        class="block w-full h-auto"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        src={after}
        alt={`${afterLabel}${alt ? `: ${alt}` : ''}`}
        class="block w-full h-auto"
      />
    )}

    <!-- After label — sits on the base layer, covered by the before wrapper when slider is dragged right -->
    <span class="absolute bottom-3 right-3 font-mono text-xs uppercase tracking-widest text-white bg-black/50 px-2 py-0.5 pointer-events-none rounded-sm">
      {afterLabel}
    </span>

    <!-- Before image + label — wrapper is clipped together so label disappears with the image -->
    <div
      class="absolute inset-0"
      style="clip-path: polygon(0% 0%, 50% 0%, 50% 100%, 0% 100%)"
      data-ba-before
    >
      {typeof before === 'string' ? (
        <img
          src={before}
          alt={`${beforeLabel}${alt ? `: ${alt}` : ''}`}
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Image
          src={before}
          alt={`${beforeLabel}${alt ? `: ${alt}` : ''}`}
          class="absolute inset-0 w-full h-full object-cover"
        />
      )}
      <span class="absolute bottom-3 left-3 font-mono text-xs uppercase tracking-widest text-white bg-black/50 px-2 py-0.5 pointer-events-none rounded-sm">
        {beforeLabel}
      </span>
    </div>

    <!-- Divider line — tall so overflow:hidden clips the angled ends cleanly -->
    <div
      class="absolute pointer-events-none"
      style="left: 50%; top: 50%; width: 2px; height: 200%; background-color: #F2DB07; transform: translateX(-50%) translateY(-50%) rotate(10deg);"
      data-ba-line
    ></div>

    <!-- Handle — unrotated circle at the drag position -->
    <div
      class="absolute pointer-events-none"
      style="left: 50%; top: 50%; transform: translateX(-50%) translateY(-50%)"
      data-ba-handle
    >
      <div class="w-9 h-9 rounded-full bg-white shadow-lg flex items-center justify-center">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M6 4L2 9L6 14" stroke="#111" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 4L16 9L12 14" stroke="#111" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  // 10° tilt from vertical (i.e. 100° from horizontal)
  const ANGLE_DEG = 10;
  const TAN_ANGLE = Math.tan(ANGLE_DEG * Math.PI / 180); // ≈ 0.1763

  function initSlider(root: HTMLElement) {
    const container  = root.querySelector<HTMLElement>('[data-ba-container]');
    const beforeImg  = root.querySelector<HTMLElement>('[data-ba-before]');
    const line       = root.querySelector<HTMLElement>('[data-ba-line]');
    const handle     = root.querySelector<HTMLElement>('[data-ba-handle]');
    if (!container || !beforeImg || !line || !handle) return;

    let dragging = false;

    function applyFraction(pct: number) {
      const { width, height } = container.getBoundingClientRect();
      // Angled right edge of the before-image clip:
      // the divider tilts 10° so its x-position varies with y.
      // halfTilt = half the horizontal offset across the full container height.
      const halfTilt  = (height / width) * TAN_ANGLE / 2;
      // rotate(10deg) is clockwise: top of line shifts right, bottom shifts left
      const topPct    = (pct + halfTilt) * 100;
      const bottomPct = (pct - halfTilt) * 100;
      beforeImg.style.clipPath =
        `polygon(0% 0%, ${topPct.toFixed(2)}% 0%, ${bottomPct.toFixed(2)}% 100%, 0% 100%)`;

      const leftStr = `${(pct * 100).toFixed(2)}%`;
      line.style.left   = leftStr;
      handle.style.left = leftStr;
    }

    function applyFromClientX(clientX: number) {
      const { left, width } = container.getBoundingClientRect();
      // Allow 60px overscroll beyond each edge so the angled slice
      // can fully exit the frame and reveal a clean 100% view.
      const over = 60 / width;
      applyFraction(Math.max(-over, Math.min(1 + over, (clientX - left) / width)));
    }

    // Set initial angled state at 50%.
    // Must wait until the container has real dimensions — lazy-loaded images
    // mean height is 0 at script-execution time, which makes halfTilt = 0
    // and leaves the clip as a straight vertical while the CSS line is rotated.
    let initialized = false;
    function maybeInit() {
      if (!initialized && container.getBoundingClientRect().height > 0) {
        initialized = true;
        applyFraction(0.5);
        ro.disconnect();
      }
    }
    const ro = new ResizeObserver(maybeInit);
    ro.observe(container);
    maybeInit(); // also try immediately for eager-loaded images

    // Mouse
    container.addEventListener('mousedown', (e) => {
      dragging = true;
      applyFromClientX(e.clientX);
      e.preventDefault();
    });
    window.addEventListener('mousemove', (e) => {
      if (dragging) applyFromClientX(e.clientX);
    });
    window.addEventListener('mouseup', () => { dragging = false; });

    // Touch
    container.addEventListener('touchstart', (e) => {
      dragging = true;
      applyFromClientX(e.touches[0].clientX);
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (dragging) applyFromClientX(e.touches[0].clientX);
    }, { passive: true });
    window.addEventListener('touchend', () => { dragging = false; });
  }

  document
    .querySelectorAll<HTMLElement>('[data-before-after]')
    .forEach(initSlider);
</script>
