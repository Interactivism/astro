---
/**
 * Homepage hero slider — full-bleed, full-viewport-height.
 *
 * Layout:
 *   TOP    — black tag chip + headline (below floating nav on mobile;
 *             padded past the fixed 360 px sidenav on desktop via lg:pl-[400px])
 *   BOTTOM — CTAs per slide, left-aligned
 *
 * Shared controls (outside slides, always visible):
 *   Desktop — box pagination  ‹ n / total ›  bottom-right, same level as CTAs
 *   Mobile  — pill-dot indicators, centered, bottom
 *
 * Accessibility:
 *   - Auto-advances every 5 s; pauses on hover and on any focus inside the region.
 *   - Arrow keys advance slides when the region has focus.
 *   - Swipe left/right on touch (mobile).
 *   - Hidden slides: aria-hidden="true"; all interactive children tabindex="-1".
 *   - Slide change: focus moves to the new slide's heading (preventScroll).
 *   - prefers-reduced-motion: transitions instant; auto-advance continues.
 *
 * SEO: slide 1 uses <h1>, work slides use <h2>. Both share identical visual
 * classes. Non-active slides carry aria-hidden so screen readers see only
 * the active heading.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from '../ui/Button.astro';

interface HeroCta { label: string; href: string; }
interface HeroData { headline: string; image: string; cta: HeroCta; tag?: string; }

interface Props {
  hero: HeroData;
  caseStudies: CollectionEntry<'caseStudies'>[];
}

const { hero, caseStudies } = Astro.props;
const totalSlides = 1 + caseStudies.length;
const heroTag = hero.tag ?? 'Interactivism';

// Shared Tailwind shorthand — clears the fixed 360 px sidenav on desktop
const desktopPad = 'lg:pl-[440px] lg:pr-20';

// Shared headline / tag classes so both h1 and h2 look identical
// Font size is fluid via CSS min() + clamp():
//   min(9vh, 11vw) picks whichever viewport dimension is more constraining —
//   height on short desktops (e.g. 1440×900), width on narrow phones (390px).
//   clamp() floors at 2.5rem (40px) and caps at 7rem (112px).
const headlineClass = 'font-display leading-display text-inverse max-w-[18ch] focus:outline-none';
const headlineStyle = 'font-size: clamp(2.5rem, min(8vh, 6vw), 7rem)';
const tagClass      = 'inline-flex items-center bg-ink-900 text-inverse font-mono text-base uppercase tracking-widest px-4 py-1.5 mb-5';
---

<section
  id="hero-slider"
  role="region"
  aria-label="Featured work"
  aria-roledescription="carousel"
  class="relative w-full h-screen overflow-hidden focus:outline-none select-none"
  tabindex="0"
>

  <!-- ============================================================
       Slide 1 — studio hero
       ============================================================ -->
  <div
    data-slide="0"
    role="group"
    aria-roledescription="slide"
    aria-label={`Slide 1 of ${totalSlides}`}
    class="absolute inset-0 opacity-100 transition-opacity duration-500 pointer-events-auto"
  >
    <img
      src={hero.image}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink-900/55 via-transparent to-transparent pointer-events-none" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-900/70 via-ink-900/10 to-transparent pointer-events-none" />

    <!-- Bottom: tag + headline + CTA stacked, left-aligned -->
    <div class={`absolute bottom-0 left-0 right-0 pb-20 lg:pb-16 px-6 ${desktopPad}`}>
      <div class={tagClass}>{heroTag}</div>
      <h1 class={headlineClass} style={headlineStyle} tabindex="-1">{hero.headline}</h1>
      <div class="mt-8 lg:mt-12">
        <Button href={hero.cta.href}>{hero.cta.label}</Button>
      </div>
    </div>
  </div>

  <!-- ============================================================
       Slides 2–N — work slides
       ============================================================ -->
  {
    caseStudies.map((cs, i) => {
      const idx = i + 1;
      return (
        <div
          data-slide={idx}
          role="group"
          aria-roledescription="slide"
          aria-label={`Slide ${idx + 1} of ${totalSlides}: ${cs.data.client}`}
          aria-hidden="true"
          class="absolute inset-0 opacity-0 pointer-events-none transition-opacity duration-500"
        >
          {cs.data.heroImage ? (
            <Image
              src={cs.data.heroImage}
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              width={1920}
              height={1080}
              loading="lazy"
            />
          ) : (
            <img
              src="/placeholders/hero-placeholder.svg"
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              aria-hidden="true"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-b from-ink-900/55 via-transparent to-transparent pointer-events-none" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-900/70 via-ink-900/10 to-transparent pointer-events-none" />

          <!-- Bottom: tag + headline + CTAs stacked, left-aligned -->
          <div class={`absolute bottom-0 left-0 right-0 pb-20 lg:pb-16 px-6 ${desktopPad}`}>
            <div class={tagClass}>{cs.data.client}</div>
            <h2 class={headlineClass} style={headlineStyle} tabindex="-1">{cs.data.title}</h2>
            <div class="mt-8 lg:mt-12 flex items-center gap-4 flex-wrap-reverse lg:pr-64">
              <Button href="/contact/" tabindex="-1">Let’s talk</Button>
              <Button href={`/work/${cs.id}/`} variant="ghost" tabindex="-1">View project</Button>
            </div>
          </div>
        </div>
      );
    })
  }

  <!-- ============================================================
       Desktop box pagination — always on top, outside slides
       Right-aligned at same bottom level as CTAs (pb-12 = 48 px)
       ============================================================ -->
  <div
    class="hidden lg:flex items-stretch min-h-[62px] absolute bottom-16 right-20 z-10 bg-paper-0/[66%] text-headline border border-ink-900/10 rounded-sm overflow-hidden transition duration-fast hover:bg-paper-0/90"
    aria-label="Slide navigation"
  >
    <button
      id="slider-prev"
      type="button"
      aria-label="Previous slide"
      class="w-14 flex items-center justify-center hover:bg-ink-900/5 active:bg-ink-900/10 transition duration-fast focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="w-px bg-ink-900/20 shrink-0" />
    <span
      id="slider-counter"
      class="px-6 py-3 flex items-center font-mono text-base font-bold text-muted tabular-nums whitespace-nowrap"
      aria-live="polite"
      aria-atomic="true"
    >
      1 / {totalSlides}
    </span>
    <div class="w-px bg-ink-900/20 shrink-0" />
    <button
      id="slider-next"
      type="button"
      aria-label="Next slide"
      class="w-14 flex items-center justify-center hover:bg-ink-900/5 active:bg-ink-900/10 transition duration-fast focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>

  <!-- ============================================================
       Mobile pill-dot indicators — always on top, centered
       h-2 is static; only width and bg change on slide change
       ============================================================ -->
  <div
    class="lg:hidden absolute bottom-0 left-0 right-0 pb-7 z-10 flex items-center justify-center gap-2"
    aria-hidden="true"
  >
    {
      Array.from({ length: totalSlides }).map((_, i) => (
        <div
          data-dot={i}
          class:list={[
            'h-2 rounded-full transition-all duration-300',
            i === 0 ? 'w-4 bg-inverse' : 'w-2 bg-inverse/40',
          ]}
        />
      ))
    }
  </div>

</section>

<script>
  const region  = document.getElementById('hero-slider') as HTMLElement;
  const prevBtn = document.getElementById('slider-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('slider-next') as HTMLButtonElement;
  const counter = document.getElementById('slider-counter') as HTMLElement;
  const slides  = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
  const dots    = Array.from(document.querySelectorAll<HTMLElement>('[data-dot]'));
  const total   = slides.length;
  let current   = 0;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion) slides.forEach(s => { s.style.transitionDuration = '0ms'; });

  // paused = true means auto-advance has been permanently stopped by user interaction.
  // Hover/focus temporarily cancel the timer without setting this flag;
  // explicit navigation (pagination, swipe) sets it and never restarts.
  // prefers-reduced-motion only suppresses the CSS fade; auto-advance still runs.
  let paused = false;

  // ── Logo variant (desktop only) ────────────────────────────────
  // Samples the logo region (80×80 inset, 200×200px crop) of the active
  // slide's background image and switches #sidenav-logo between
  // logo-light.svg and logo-dark.svg for contrast.
  // Only runs on lg+ where the sidenav logo is visible.

  const sidnavLogo = document.getElementById('sidenav-logo') as HTMLImageElement | null;

  /**
   * Object-cover coordinate mapping.
   * Returns the source rect (in natural image pixels) that corresponds to
   * the viewport rect (vx, vy, vw, vh) when the image is rendered with
   * object-cover behaviour at full viewport size.
   */
  function objectCoverSrcRect(
    natW: number, natH: number,
    viewW: number, viewH: number,
    vx: number, vy: number, vw: number, vh: number
  ) {
    const scale  = Math.max(viewW / natW, viewH / natH);
    const offsetX = (natW * scale - viewW) / 2;  // may be 0
    const offsetY = (natH * scale - viewH) / 2;
    return {
      sx: (vx + offsetX) / scale,
      sy: (vy + offsetY) / scale,
      sw: vw / scale,
      sh: vh / scale,
    };
  }

  function sampleLogoVariant(img: HTMLImageElement): 'light' | 'dark' {
    try {
      const canvas = document.createElement('canvas');
      canvas.width  = 200;
      canvas.height = 200;
      const ctx = canvas.getContext('2d');
      if (!ctx) return 'light';

      const { sx, sy, sw, sh } = objectCoverSrcRect(
        img.naturalWidth, img.naturalHeight,
        window.innerWidth, window.innerHeight,
        80, 80, 200, 200
      );
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, 200, 200);

      const data = ctx.getImageData(0, 0, 200, 200).data;
      let sum = 0;
      for (let i = 0; i < data.length; i += 4) {
        sum += 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
      }
      return (sum / (data.length / 4)) >= 197 ? 'dark' : 'light';
    } catch {
      return 'light';
    }
  }

  /**
   * Schedules a logo variant update for `img`.
   * If the image is already decoded, samples immediately; otherwise waits for load.
   * The 250ms delay places the swap at the midpoint of the 500ms opacity fade
   * so the switch is effectively invisible.
   */
  function scheduleLogo(img: HTMLImageElement, delay = 250) {
    if (!sidnavLogo) return;
    const run = () => setTimeout(() => {
      if (sidnavLogo) sidnavLogo.src = `/brand/logo-${sampleLogoVariant(img)}.svg`;
    }, delay);
    img.complete && img.naturalWidth > 0 ? run() : img.addEventListener('load', run, { once: true });
  }

  // ── Helpers ────────────────────────────────────────────────────

  function setFocusable(slide: HTMLElement, allow: boolean) {
    slide.querySelectorAll<HTMLElement>('a, button').forEach(el =>
      allow ? el.removeAttribute('tabindex') : el.setAttribute('tabindex', '-1')
    );
  }

  function syncDots(active: number) {
    dots.forEach((dot, i) => {
      const on = i === active;
      // width: pill (w-4) when active, circle (w-2) when not
      dot.classList.toggle('w-4', on);
      dot.classList.toggle('w-2', !on);
      // opacity: full when active, dim when not
      dot.classList.toggle('bg-inverse', on);
      dot.classList.toggle('bg-inverse/40', !on);
    });
  }

  // ── Core navigation ────────────────────────────────────────────

  function goTo(n: number) {
    const prev = slides[current];
    current = ((n % total) + total) % total;
    const next = slides[current];

    prev.classList.replace('opacity-100', 'opacity-0');
    prev.classList.add('pointer-events-none');
    prev.setAttribute('aria-hidden', 'true');
    setFocusable(prev, false);

    next.classList.replace('opacity-0', 'opacity-100');
    next.classList.remove('pointer-events-none');
    next.removeAttribute('aria-hidden');
    setFocusable(next, true);

    if (counter) counter.textContent = `${current + 1} / ${total}`;
    syncDots(current);

    // Update sidenav logo variant at the mid-point of the opacity fade.
    const nextImg = next.querySelector<HTMLImageElement>('img');
    if (nextImg) scheduleLogo(nextImg);

    next.querySelector<HTMLElement>('h1, h2')?.focus({ preventScroll: true });
    stopAdvance();
  }

  // ── Auto-advance ───────────────────────────────────────────────

  let timer: ReturnType<typeof setTimeout> | null = null;

  function tick() {
    const prev = slides[current];
    current = (current + 1) % total;
    const next = slides[current];

    prev.classList.replace('opacity-100', 'opacity-0');
    prev.classList.add('pointer-events-none');
    prev.setAttribute('aria-hidden', 'true');
    setFocusable(prev, false);

    next.classList.replace('opacity-0', 'opacity-100');
    next.classList.remove('pointer-events-none');
    next.removeAttribute('aria-hidden');
    setFocusable(next, true);

    if (counter) counter.textContent = `${current + 1} / ${total}`;
    syncDots(current);

    // Update sidenav logo variant at the mid-point of the opacity fade.
    const nextImg = next.querySelector<HTMLImageElement>('img');
    if (nextImg) scheduleLogo(nextImg);

    timer = setTimeout(tick, 5000);
  }

  function startAdvance()  { if (!paused && !timer) timer = setTimeout(tick, 5000); }
  function cancelAdvance() { if (timer) { clearTimeout(timer); timer = null; } }
  function stopAdvance()   { paused = true; cancelAdvance(); }

  startAdvance();

  region.addEventListener('mouseenter', cancelAdvance);
  region.addEventListener('mouseleave', startAdvance);
  region.addEventListener('focusin',    cancelAdvance);
  region.addEventListener('focusout',   startAdvance);

  // ── Controls ───────────────────────────────────────────────────

  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));

  region.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(current - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
  });

  let touchStartX = 0;
  region.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  region.addEventListener('touchend', (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) goTo(dx < 0 ? current + 1 : current - 1);
  }, { passive: true });
</script>
