#!/usr/bin/env node
/**
 * Pre-commit hook — stamps lastUpdatedBy + lastUpdatedAt into the frontmatter
 * of any staged case study MDX file before each commit.
 *
 * Install once (or after cloning):
 *   npm run prepare
 *
 * The hook reads git config user.name (falls back to user.email) and the
 * current UTC timestamp, then writes them as YAML text fields so they show
 * up in the Keystatic collection list view.
 */

import { execSync }           from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';
import { resolve, dirname }   from 'node:path';
import { fileURLToPath }      from 'node:url';

// ── paths ──────────────────────────────────────────────────────────────────
const __dirname   = dirname(fileURLToPath(import.meta.url));
const projectRoot = resolve(__dirname, '..');                     // …/Interactivism
const repoRoot    = execSync('git rev-parse --show-toplevel').toString().trim();

// Relative prefix of this project inside the repo (e.g. "Claude/Interactivism").
// Empty string when the repo root IS the project root.
const prefix = projectRoot === repoRoot
  ? ''
  : projectRoot.slice(repoRoot.length + 1);

const CASE_STUDY_RE = new RegExp(
  `^${prefix ? prefix + '/' : ''}src/content/caseStudies/[^/]+\\.mdx$`
);

// ── collect staged case-study files ────────────────────────────────────────
const staged = execSync('git diff --cached --name-only --diff-filter=ACM')
  .toString().trim().split('\n').filter(Boolean)
  .filter(f => CASE_STUDY_RE.test(f));

if (staged.length === 0) process.exit(0);

// ── author + timestamp ──────────────────────────────────────────────────────
const author = (() => {
  try { const v = execSync('git config user.name').toString().trim(); if (v) return v; } catch (_) {}
  try { const v = execSync('git config user.email').toString().trim(); if (v) return v; } catch (_) {}
  return 'Unknown';
})();

const now = new Date().toISOString(); // e.g. "2026-05-13T14:30:00.000Z"

// ── frontmatter helpers ─────────────────────────────────────────────────────
/** Set or insert a YAML text field between the opening --- markers. */
function setField(content, key, value) {
  const line = `${key}: ${JSON.stringify(value)}`;
  const re   = new RegExp(`^${key}:.*$`, 'm');
  return re.test(content)
    ? content.replace(re, line)
    : content.replace(/^---(\r?\n)/, `---$1${line}\n`);
}

// ── update each file ────────────────────────────────────────────────────────
for (const rel of staged) {
  const abs = resolve(repoRoot, rel);
  let src = readFileSync(abs, 'utf8');
  src = setField(src, 'lastUpdatedBy', author);
  src = setField(src, 'lastUpdatedAt', now);
  writeFileSync(abs, src);
  execSync(`git add "${abs}"`);
}

console.log(
  `[pre-commit] stamped ${staged.length} case study file(s) → lastUpdatedBy="${author}"`
);
