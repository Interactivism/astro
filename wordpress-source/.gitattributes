# Track binary media assets with Git LFS to avoid bloating the repo
wp-content/uploads/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.jpeg  filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.png   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.gif   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.webp  filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.svg   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.mp4   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.mov   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.pdf   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.mp3   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.woff  filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.woff2 filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.eot   filter=lfs diff=lfs merge=lfs -text
wp-content/uploads/**/*.ttf   filter=lfs diff=lfs merge=lfs -text
