# Track binary media assets with Git LFS to avoid bloating the repo
uploads/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
uploads/**/*.png  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.gif  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.webp filter=lfs diff=lfs merge=lfs -text
uploads/**/*.svg  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.mp4  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.mov  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.zip  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.mp3  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.woff filter=lfs diff=lfs merge=lfs -text
uploads/**/*.woff2 filter=lfs diff=lfs merge=lfs -text
uploads/**/*.eot  filter=lfs diff=lfs merge=lfs -text
uploads/**/*.ttf  filter=lfs diff=lfs merge=lfs -text
